# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include directories needed for the build. Without this, buildah/podman
# (unlike BuildKit) treats these as fully excluded by the "**" rule above and
# fails COPY with "no such file or directory" even though the *.go negation
# below re-includes files inside them.
!cmd/
!api/
!assets/
!config/
!internal/
!pkg/
!test/

# Re-include all Go source files
!**/*.go
# Exclude *_test.go files from directories other than test/
cmd/*_test.go
api/*_test.go
internal/*_test.go
pkg/*_test.go
assets/*_test.go

# Re-include Go module files
!go.mod
!go.sum
