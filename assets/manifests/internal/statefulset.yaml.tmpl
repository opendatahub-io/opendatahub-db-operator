apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{.Service.Name}}
  namespace: {{.Namespace}}
  labels:
    app.kubernetes.io/name: {{.Service.Name}}
    app.kubernetes.io/component: databaseprovider
    db.infrastructure.opendatahub.io/provider: {{.ProviderName}}
spec:
  replicas: {{.Postgres.Replicas}}
  serviceName: {{.Service.Name}}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{.Service.Name}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{.Service.Name}}
        db.infrastructure.opendatahub.io/provider: {{.ProviderName}}
{{- if .Postgres.InstanceHash}}
      annotations:
        db.infrastructure.opendatahub.io/admin-secret-key: {{.Postgres.InstanceHash}}
{{- if and .TLS.Enabled .TLS.SecretHash}}
        db.infrastructure.opendatahub.io/tls-secret-hash: {{.TLS.SecretHash}}
{{- end}}
{{- end}}
    spec:
      serviceAccountName: {{.ServiceAccountName}}
      automountServiceAccountToken: false
      securityContext:
        runAsUser: {{.PostgresUID}}
        runAsGroup: {{.PostgresUID}}
        fsGroup: {{.PostgresUID}}
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: postgres
          image: {{.Postgres.Image}}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
{{- if .TLS.Enabled}}
          args:
            - run-postgresql
            - -c
            - ssl=on
            - -c
            - ssl_cert_file=/var/lib/pgsql/tls/tls.crt
            - -c
            - ssl_key_file=/var/lib/pgsql/tls/tls.key
{{- end}}
          ports:
            - name: postgres
              containerPort: 5432
              protocol: TCP
          env:
            # The generated admin Secret uses the image-reserved postgres account.
            - name: POSTGRESQL_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{.Postgres.AdminSecretName}}
                  key: password
            - name: INTERNAL_POSTGRES_DATABASE
              valueFrom:
                secretKeyRef:
                  name: {{.Postgres.AdminSecretName}}
                  key: dbname
{{- with .Postgres.Envs }}
{{ toYaml . | nindent 12 }}
{{- end }}
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U postgres -d "$INTERNAL_POSTGRES_DATABASE"
            initialDelaySeconds: 5
            timeoutSeconds: 5
          startupProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U postgres -d "$INTERNAL_POSTGRES_DATABASE"
            periodSeconds: 5
            failureThreshold: 30
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U postgres -d "$INTERNAL_POSTGRES_DATABASE"
            initialDelaySeconds: 15
            timeoutSeconds: 5
            failureThreshold: 6
{{- with .Postgres.Resources }}
          resources:{{ toYaml . | nindent 12 }}
{{- end }}
          volumeMounts:
            - name: data
              mountPath: /var/lib/pgsql/data
            - name: initdb
              mountPath: /opt/app-root/src/postgresql-init
{{- if .TLS.Enabled}}
            - name: tls
              mountPath: /var/lib/pgsql/tls
              readOnly: true
{{- end}}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{.PVC.Name}}
        - name: initdb
          configMap:
            name: {{.InitDB.ConfigMapName}}
{{- if .TLS.Enabled}}
        - name: tls
          secret:
            secretName: {{.TLS.SecretName}}
            defaultMode: 416
{{- end}}
